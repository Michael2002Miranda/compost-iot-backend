# Copiar a .env y completar con los datos de Supabase (Project Settings > Database)
PORT=3000

DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_NAME=postgres

# Dejar en false solo si la base es local sin SSL.
DB_SSL=true

# Clave que debe enviar el ESP32 en la cabecera `x-api-key`.
# Si se deja vacía, la API acepta escrituras sin autenticación (solo desarrollo).
DEVICE_API_KEY=
